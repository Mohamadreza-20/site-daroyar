{
  "name": "daroyar-pharmacy-store",
  "version": "1.0.0",
  "description": "Daroyar - demo pharmacy storefront (React + TypeScript + Tailwind CSS)",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm:server\" \"npm:client\"",
    "client": "vite",
    "server": "tsx server/index.ts",
    "server:reset": "tsx server/index.ts --reset",
    "seed": "tsx server/seed/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write src server plugins"
  },
  "type": "module",
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@tanstack/react-query": "^5.104.4",
    "axios": "^1.20.0",
    "express": "^4.22.3",
    "framer-motion": "^14.3.0",
    "json-server": "^0.17.4",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "swiper": "^14.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "private": true,
  "license": "MIT"
}
